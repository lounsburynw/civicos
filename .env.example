# ============================================================================
# Civic Conversational OS - Environment Variables
# ============================================================================
# Copy this file to .env and fill in your values:
#   cp .env.example .env
#
# Variables marked [REQUIRED] must be set in production.
# Variables marked [REQUIRED-PROD] are only required for production/staging.
# Variables marked [OPTIONAL] have sensible defaults.
# ============================================================================

# ============================================================================
# ENVIRONMENT & DEPLOYMENT
# ============================================================================

# [REQUIRED] Environment name: development, staging, or production
CIVICOS_ENV=development

# [OPTIONAL] API server port (defaults: dev=8001, staging=8002, prod=8000)
CIVICOS_API_PORT=8001

# [OPTIONAL] Enable debug mode (development only, never in production)
# DEBUG=true

# ============================================================================
# AUTHENTICATION
# ============================================================================

# [REQUIRED-PROD] Web interface authentication token
# Use 'dev_key_local' for local development
# Generate a strong random token for production: openssl rand -hex 32
CIVICOS_WEB_KEY=dev_key_local

# [OPTIONAL] Demo user authentication key (for testing)
# CIVICOS_DEMO_KEY=demo_key_local

# [OPTIONAL] Test user authentication key (for automated tests)
# CIVICOS_TEST_KEY=test_key_local

# [OPTIONAL] Development mode - skips some validation
# CIVICOS_DEV_MODE=true

# ============================================================================
# JURISDICTION CONFIGURATION
# ============================================================================

# [OPTIONAL] Default jurisdiction for MCP server and API queries
# Format: 'san-rafael', 'city-san-rafael', or underscore variant
# All formats are normalized to canonical form (e.g., 'city-san-rafael')
# CIVICOS_JURISDICTION=city-san-rafael

# [OPTIONAL] Display name override (defaults to JurisdictionRegistry lookup)
# CIVICOS_DISPLAY_NAME=San Rafael, CA

# [OPTIONAL] Timezone override (defaults to JurisdictionRegistry lookup)
# CIVICOS_TIMEZONE=America/Los_Angeles

# [OPTIONAL] Path to YAML config file (alternative to env vars)
# See civicos.example.yaml for schema
# CIVICOS_CONFIG=/path/to/civicos.yaml

# [OPTIONAL] Enable federated queries across multiple CivicOS instances
# CIVICOS_FEDERATION_ENABLED=false

# ============================================================================
# CORS & SECURITY (Production)
# ============================================================================

# [REQUIRED-PROD] Comma-separated list of allowed CORS origins
# Required for production/staging, not needed for local development
# Example: https://civic.example.com,https://staging.civic.example.com
# CIVICOS_CORS_ORIGINS=https://your-domain.com

# ============================================================================
# RATE LIMITING
# ============================================================================

# [OPTIONAL] Force rate limiting in development (default: false, always on in prod)
# ENABLE_RATE_LIMIT=true

# [OPTIONAL] Rate limiting configuration
# RATE_LIMIT_PER_MINUTE=60
# RATE_LIMIT_PER_HOUR=1000
# RATE_LIMIT_BURST=10

# ============================================================================
# SESSION MANAGEMENT
# ============================================================================

# [OPTIONAL] Session configuration
# MAX_SESSIONS=1000
# SESSION_TIMEOUT=60
# SESSION_CLEANUP_INTERVAL=15
# MAX_CONVERSATION_SIZE_KB=100

# ============================================================================
# LLM PROVIDERS - PRIMARY
# ============================================================================

# [REQUIRED] OpenAI API Key - Required for AI features
# Get your key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-...

# [OPTIONAL] OpenAI configuration
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_TEMPERATURE=0.7
# OPENAI_MAX_TOKENS=2000
# OPENAI_TIMEOUT=30
# OPENAI_FALLBACK_MODEL=gpt-3.5-turbo

# [OPTIONAL] Provider selection - override default OpenAI
# Options: openai, google, groq, ollama, anthropic, perplexity, openrouter
# LLM_PROVIDER=openai

# ============================================================================
# LLM PROVIDERS - ALTERNATIVE (Uncomment to use)
# ============================================================================

# --- Google Gemini ---
# GOOGLE_API_KEY=your-google-api-key
# Get from: https://console.cloud.google.com/apis/credentials

# --- Anthropic Claude ---
# ANTHROPIC_API_KEY=your-anthropic-api-key
# ENABLE_ANTHROPIC=true
# Get from: https://console.anthropic.com/

# --- Groq (Fast inference) ---
# GROQ_API_KEY=your-groq-api-key
# Get from: https://console.groq.com

# --- Ollama (Local, free) ---
# OLLAMA_BASE_URL=http://localhost:11434/v1
# OLLAMA_MODEL=llama3.1

# --- Perplexity (Research/search) ---
# PERPLEXITY_API_KEY=your-perplexity-api-key
# Get from: https://www.perplexity.ai/settings/api

# --- OpenRouter (Unified access to many models) ---
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_APP_NAME=civic-conversational-os
# OPENROUTER_SITE_URL=https://github.com/civic-os
# Get from: https://openrouter.ai/keys

# ============================================================================
# DATABASE
# ============================================================================

# [OPTIONAL] Database URL - Controls which storage backend to use
# If not set, defaults to local SQLite at data/civic_state.db
#
# SQLite (development/single-server):
#   DATABASE_URL=sqlite:///data/civic_state.db
#
# PostgreSQL (production/multi-user):
#   DATABASE_URL=postgresql://user:password@host:5432/civic
#
# Free Postgres options:
#   - Supabase: https://supabase.com (500MB free)
#   - Neon: https://neon.tech (512MB free, serverless)
#   - Fly.io: https://fly.io/docs/postgres (shared instance)
#
# DATABASE_URL=postgresql://user:password@host:5432/civic

# ============================================================================
# BLOB STORAGE
# ============================================================================

# [OPTIONAL] Blob storage for large files (PDFs, audio, transcripts)
# If not set, defaults to local filesystem at data/blobs/
#
# Local (development):
#   BLOB_STORAGE_URL=local://data/blobs
#
# Cloudflare R2 (production - S3-compatible, 10GB free, zero egress):
#   BLOB_STORAGE_URL=r2://account_id/bucket_name
#   R2_ACCESS_KEY_ID=your_access_key_id
#   R2_SECRET_ACCESS_KEY=your_secret_access_key
#
# Get R2 credentials from: https://dash.cloudflare.com/ -> R2 -> Manage R2 API Tokens
#
# BLOB_STORAGE_URL=r2://account_id/civic-blobs
# R2_ACCESS_KEY_ID=your_access_key_id
# R2_SECRET_ACCESS_KEY=your_secret_access_key

# ============================================================================
# EMBEDDINGS
# ============================================================================

# [OPTIONAL] Embedding provider: local (default) or openai
# Local uses all-MiniLM-L6-v2, free but slightly lower quality
# OpenAI uses text-embedding-3-small, costs money but better quality
# CIVICOS_EMBEDDING_PROVIDER=local

# [OPTIONAL] Embedding model name
# For local: all-MiniLM-L6-v2 (default), nomic-embed-text-v1.5 (future)
# For openai: text-embedding-3-small (default), text-embedding-3-large
# CIVICOS_EMBEDDING_MODEL=all-MiniLM-L6-v2

# ============================================================================
# LOCATION & MAPPING
# ============================================================================

# [OPTIONAL] Google Maps API Key - For address geocoding
# Get your key from: https://console.cloud.google.com/apis/credentials
# Enable Geocoding API in your Google Cloud project
GOOGLE_MAPS_API_KEY=AIza...

# [OPTIONAL] IPInfo API Token - For IP-based location fallback
# IPINFO_TOKEN=your-ipinfo-token
# Get from: https://ipinfo.io/

# ============================================================================
# LEGISLATIVE DATA
# ============================================================================

# [OPTIONAL] LegiScan API Key - For state/federal legislative data
# LEGISCAN_API_KEY=your-legiscan-api-key
# Get from: https://legiscan.com/legiscan

# [OPTIONAL] Legislative data configuration
# LEGISLATIVE_CACHE_TTL=3600
# LEGISLATIVE_CONTEXT_PATH=data/legislative_context
# FEDERAL_PROGRAMS_PATH=data/federal_programs

# ============================================================================
# PDF PARSING (Advanced - Optional Services)
# ============================================================================

# [OPTIONAL] LlamaParse - Better PDF parsing for complex documents
# LLAMAPARSE_API_KEY=your-llamaparse-api-key
# Get from: https://cloud.llamaindex.ai/

# [OPTIONAL] Azure Document Intelligence
# AZURE_DOCUMENT_INTELLIGENCE_KEY=your-azure-key
# AZURE_ENDPOINT=https://your-resource.cognitiveservices.azure.com/

# [OPTIONAL] Mistral API - For extraction tasks
# MISTRAL_API_KEY=your-mistral-api-key

# ============================================================================
# ALERTING & NOTIFICATIONS
# ============================================================================

# [OPTIONAL] Alert email configuration
# CIVICOS_ALERT_EMAILS=admin@example.com,ops@example.com
# CIVICOS_SMTP_SERVER=smtp.gmail.com
# CIVICOS_SMTP_PORT=587
# CIVICOS_SMTP_USERNAME=your-email@gmail.com
# CIVICOS_SMTP_PASSWORD=your-app-password

# [OPTIONAL] Push notifications for pipeline alerts (pick one)
#
# Recommended: ntfy - permissionless push notifications
# Install ntfy app (iOS/Android), subscribe to your topic, done.
# Pick a topic name with randomness so it's not guessable.
# CIVICOS_NTFY_TOPIC=civicos-admin-a7f3b2
# CIVICOS_NTFY_URL=https://ntfy.sh
#
# Legacy: Slack incoming webhook (still supported)
# CIVICOS_SLACK_WEBHOOK_URL=https://hooks.slack.com/services/T00000000/B00000000/XXXXXXXX

# [OPTIONAL] Gmail configuration (for digest features)
# GMAIL_EMAIL=your-email@gmail.com
# GMAIL_APP_PASSWORD=your-app-specific-password
# Note: Create app password at https://myaccount.google.com/apppasswords

# ============================================================================
# TRANSCRIPTION SERVICES
# ============================================================================

# [OPTIONAL] AssemblyAI - For meeting transcription
# ASSEMBLYAI_API_KEY=your-assemblyai-api-key
# Get from: https://www.assemblyai.com/

# ============================================================================
# END OF CONFIGURATION
# ============================================================================
# For questions or issues, see docs/critical/PILOT_ROADMAP.md
# or open an issue at https://github.com/civic-os/civic
