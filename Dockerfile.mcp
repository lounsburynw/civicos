# CivicOS MCP Server - Docker Image
# Optimized for MCP HTTP transport deployment
# Serves Claude.ai, ChatGPT, and other MCP-compatible clients
#
# See docs/critical/MCP_INTEGRATION_STRATEGY.md for details

# Stage 1: Build dependencies
FROM python:3.11-slim AS builder

# Install build dependencies for native extensions
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    gcc \
    g++ \
    && rm -rf /var/lib/apt/lists/*

# Create virtual environment
RUN python -m venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Install Python dependencies
COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip && \
    pip install --no-cache-dir -r requirements.txt

# Install MCP dependencies (from apps/civicos-mcp/pyproject.toml)
RUN pip install --no-cache-dir "mcp[cli]>=1.13.1" httpx

# Install PostgreSQL client (required for DATABASE_URL connection)
RUN pip install --no-cache-dir psycopg2-binary

# Install civicos-config package (shared configuration, required by civicos)
COPY packages/civicos-config/pyproject.toml /tmp/civicos-config/
COPY packages/civicos-config/src /tmp/civicos-config/src
RUN pip install --no-cache-dir /tmp/civicos-config

# Install civicos package (required by MCP server)
COPY packages/civicos/pyproject.toml packages/civicos/README.md /tmp/civicos/
COPY packages/civicos/src /tmp/civicos/src
RUN pip install --no-cache-dir /tmp/civicos[embeddings]

# Pre-download embedding model during build (avoids 30-60s download at runtime)
# Model is cached in /root/.cache/fastembed (fastembed default)
RUN python -c "from fastembed import TextEmbedding; m = TextEmbedding('nomic-ai/nomic-embed-text-v1.5'); list(m.embed(['warmup']))"

# Stage 2: Runtime image
FROM python:3.11-slim AS runtime

# Install runtime dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy virtual environment from builder
COPY --from=builder /opt/venv /opt/venv
ENV PATH="/opt/venv/bin:$PATH"

# Create non-root user for security
RUN useradd --create-home --shell /bin/bash civicos

# Copy pre-downloaded embedding model from builder
# FastEmbed caches models in /tmp/fastembed_cache by default
COPY --from=builder /tmp/fastembed_cache /tmp/fastembed_cache
# Make cache readable by all users (civicos needs to read the model)
RUN chmod -R a+rX /tmp/fastembed_cache
# Also set env var to ensure civicos user can find it
ENV FASTEMBED_CACHE_PATH=/tmp/fastembed_cache
WORKDIR /app

# Copy civicos packages source (needed for imports)
COPY packages/civicos-config/src ./packages/civicos-config/src
COPY packages/civicos/src ./packages/civicos/src

# Copy MCP server, federation module, and validator
COPY apps/civicos-mcp/civicos_server.py ./apps/civicos-mcp/
COPY apps/civicos-mcp/federation.py ./apps/civicos-mcp/
COPY apps/civicos_input_validator.py ./apps/

# Set ownership
RUN chown -R civicos:civicos /app

# Switch to non-root user
USER civicos

# Environment defaults
ENV CIVICOS_ENV=production
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1

# Default port for MCP HTTP transport
EXPOSE 8000

# Health check - verify server is listening (406 is expected without SSE headers)
# start-period=30s to allow embedding model initialization
HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -s -o /dev/null -w "%{http_code}" http://localhost:8000/mcp | grep -qE "^(200|406)$" || exit 1

# Default command: MCP server with HTTP transport
CMD ["python", "apps/civicos-mcp/civicos_server.py", "-t", "http", "--host", "0.0.0.0", "-p", "8000"]
