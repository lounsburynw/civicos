{
  "name": "@civicos/personal-mcp",
  "version": "0.1.0",
  "description": "Personal MCP server for client-side identity, signing, and context management",
  "type": "module",
  "main": "dist/src/server.js",
  "types": "dist/src/server.d.ts",
  "bin": {
    "personal-mcp-stdio": "./dist/src/server.js",
    "personal-mcp-http": "./dist/src/http-server.js"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/src/server.js",
    "start:http": "node dist/src/http-server.js",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "eslint src lib --ext .ts"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@noble/curves": "^1.4.0",
    "@noble/hashes": "^1.4.0",
    "@scure/bip32": "^1.4.0",
    "@scure/bip39": "^1.3.0",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "idb-keyval": "^6.2.1"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.10.0",
    "@types/supertest": "^6.0.3",
    "@typescript-eslint/eslint-plugin": "^6.19.0",
    "@typescript-eslint/parser": "^6.19.0",
    "eslint": "^8.56.0",
    "supertest": "^7.2.2",
    "typescript": "^5.3.0",
    "vitest": "^1.2.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "files": [
    "dist",
    "lib"
  ]
}
