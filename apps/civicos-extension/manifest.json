{
  "manifest_version": 3,
  "name": "CivicOS",
  "version": "0.1.0",
  "description": "Your civic edge agent — identity, voice, and coordination for local governance.",
  "permissions": [
    "sidePanel",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "https://*.civicosproject.org/*"
  ],
  "optional_host_permissions": [
    "https://*.civicos.dev/*",
    "https://*.openai.com/*",
    "https://claude.ai/*"
  ],
  "background": {
    "service_worker": "service-worker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "src/side-panel/index.html"
  },
  "action": {
    "default_popup": "src/popup/index.html",
    "default_title": "CivicOS"
  },
  "options_page": "src/options/index.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content-scripts/nip07-provider.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  }
}
