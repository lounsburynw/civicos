# CivicOS MCP Server - Container Deployment
#
# Build:
#   docker build -f Dockerfile.mcp -t civicos-mcp .
#
# Run:
#   docker run -p 8080:8080 \
#     -e DATABASE_URL="postgresql://..." \
#     -e CIVICOS_JURISDICTION="city-san-rafael" \
#     civicos-mcp
#
# For development (with local packages mounted):
#   docker run -p 8080:8080 \
#     -v $(pwd)/packages/civicos:/app/civicos \
#     -v $(pwd)/apps/civicos-mcp:/app/civicos-mcp \
#     -e DATABASE_URL="..." \
#     civicos-mcp

FROM python:3.11-slim

# Install system dependencies
RUN apt-get update && apt-get install -y \
    libpq-dev \
    gcc \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Set working directory
WORKDIR /app

# Copy requirements first (for Docker layer caching)
COPY apps/civicos-mcp/requirements-mcp.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt

# Pre-download embedding model to avoid runtime download
RUN python -c "from fastembed import TextEmbedding; TextEmbedding('nomic-ai/nomic-embed-text-v1.5')"

# Copy local packages
COPY packages/civicos /app/civicos
COPY packages/civicos-config /app/civicos_config
COPY packages/civicos-relay /app/civicos_relay

# Copy MCP server code
COPY apps/civicos-mcp /app/civicos-mcp
COPY apps/civicos_input_validator.py /app/civicos_input_validator.py

# Set Python path
ENV PYTHONPATH="/app:/app/civicos-mcp:${PYTHONPATH}"

# Default environment variables
ENV PORT=8080
ENV HOST=0.0.0.0
ENV CIVICOS_JURISDICTION=city-san-rafael

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=60s --retries=3 \
    CMD curl -f http://localhost:${PORT}/health || exit 1

# Expose port
EXPOSE 8080

# Run the MCP server with uvicorn
# The server uses FastAPI under the hood (from fastmcp)
CMD ["python", "-m", "uvicorn", "civicos-mcp.server:app", "--host", "0.0.0.0", "--port", "8080"]
