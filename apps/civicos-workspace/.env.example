# Civic Workspace - Frontend Environment Variables
# ⚠️  ONLY NEEDED FOR PRODUCTION DEPLOYMENT
# Local development works without this file (uses defaults + Vite proxy)

# Copy this file to .env for production deployment:
# cp .env.example .env

# API Base URL - Backend server URL
# Leave empty in development (uses Vite proxy to localhost:8001)
# Set to full URL in production (e.g., https://api.civic.example.com)
VITE_API_BASE_URL=

# API Key - Authentication token for API requests
# Must match CIVIC_WEB_KEY in backend .env
# Defaults to 'dev_key_local' for local development
VITE_API_KEY=dev_key_local
