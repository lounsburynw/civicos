# CivicOS Relay — Environment Variables
# Copy to .env and fill in values before running docker compose up.

# --- Required ---

# Unique relay identifier (e.g., relay.civicos.org/city-berkeley)
RELAY_ID=relay.local

# Jurisdiction this relay serves (e.g., city-berkeley)
RELAY_JURISDICTION=

# PostgreSQL password (used by both relay and relay-db containers)
POSTGRES_PASSWORD=change-me-in-production

# --- Optional ---

# Port to expose the relay on the host (default: 8003)
# RELAY_PORT=8003

# Acceptance policy — rate limiting and attestation verification (default: true)
# RELAY_ACCEPTANCE_POLICY=true

# Peer relay URLs for federation (comma-separated)
# RELAY_PEERS=https://relay.civicos.org/san-rafael

# Enable peer-to-peer sync (default: true)
# RELAY_SYNC_ENABLED=true

# --- Token Issuance (advanced) ---

# 32-byte hex secret for blind signature token issuance
# Generate with: python3 -c "import secrets; print(secrets.token_hex(32))"
# TOKEN_ISSUER_SECRET=

# Shared HMAC secret for voucher-gated token issuance
# VOUCHER_HMAC_SECRET=
